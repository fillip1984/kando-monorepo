{
  "name": "@kando/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build": "pnpm typecheck && pnpm lint",
    "clean": "git clean -xdf .cache .expo android ios node_modules",
    "dev": "expo start",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit",
    "build:interactive": "pnpm lint && eas build -p ios -e production --local",
    "build:production": "pnpm lint && eas build -p ios -e production --local --non-interactive"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.2",
    "@expo/metro-runtime": "^57.0.14",
    "@expo/ui": "~57.0.14",
    "@kando/db": "workspace:*",
    "@legendapp/list": "^3.3.9",
    "@react-native-vector-icons/common": "^13.0.2",
    "@react-native-vector-icons/lucide": "^13.1.3",
    "@react-native/metro-config": "^0.87.1",
    "@tanstack/react-query": "^5.102.7",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "^57.0.2",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "metro-cache": "^0.87.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "~0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "sonner-native": "^0.27.0",
    "superjson": "2.2.6",
    "tailwind-merge": "^3.6.0",
    "uniwind": "^1.11.0"
  },
  "devDependencies": {
    "@kando/api": "workspace:*",
    "@kando/eslint-config": "workspace:*",
    "@kando/prettier-config": "workspace:*",
    "@kando/tailwind-config": "workspace:*",
    "@kando/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "19.2.18",
    "eslint": "^9.39.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "prettier": "@kando/prettier-config"
}
